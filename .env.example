# .env.example — copy to .env, fill in real values, NEVER commit .env
#
# Usage:
#   cp .env.example .env
#   nano .env          # paste your real keys
#   source .env        # or: set -a && . .env && set +a
#
# All keys are read via os.environ — Orion never hard-codes secrets.

# --- Redis (distributed mode) ----------------------------------------------- #
ORION_REDIS_URL=redis://127.0.0.1:6379/0

# --- AI co-analyst (pick one provider) --------------------------------------- #
ORION_LLM_API_KEY=            # openai/anthropic API key (leave blank for ollama)

# --- Notifications (at least one to enable) ---------------------------------- #
ORION_DISCORD_WEBHOOK=        # https://discord.com/api/webhooks/<id>/<token>
ORION_TELEGRAM_TOKEN=         # bot token from @BotFather
ORION_TELEGRAM_CHAT=          # chat_id (use @userinfobot to find yours)

# --- Breach / OSINT (optional) ----------------------------------------------- #
ORION_BREACH_API_KEY=         # HIBP API key from haveibeenpwned.com/API/Key

# --- Campaign identity (optional but recommended) ----------------------------- #
ORION_ENGAGEMENT_ID=          # e.g. ENG-2026-07  (printed in every request header)
